# Copia este archivo a .env.local y rellena los valores de tu proyecto de
# Supabase (Settings → API en el panel de Supabase).
#
# Estas dos son claves PÚBLICAS (van al navegador): no incluyen ningún
# permiso especial por sí mismas, el acceso real lo controlan las políticas
# de Row Level Security definidas en supabase/schema.sql.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
